 \"title\": \"Score\"}, \"max_score\": {\"anyOf\": [{\"type\": \"number\"}, {\"type\": \"null\"}], \"title\": \"Max Score\"}, \"final_decision\": {\"anyOf\": [{\"type\": \"string\", \"enum\": [\"AUTO_ACCEPT\", \"MANUAL_REVIEW_REQUIRED\"]}, {\"type\": \"null\"}], \"title\": \"Final Decision\"}, \"needs_curator\": {\"type\": \"boolean\", \"title\": \"Needs Curator\", \"default\": false}, \"review_required\": {\"type\": \"boolean\", \"title\": \"Review Required\", \"default\": false}, \"review_reason\": {\"type\": \"string\", \"title\": \"Review Reason\", \"default\": \"\"}, \"uncertainty_point\": {\"anyOf\": [{\"$ref\": \"#/definitions/UncertaintyPoint\"}, {\"type\": \"null\"}]}}, \"type\": \"object\", \"title\": \"Feedback\"}, \"HTTPValidationError\": {\"properties\": {\"detail\": {\"items\": {\"$ref\": \"#/definitions/ValidationError\"}, \"type\": \"array\", \"title\": \"Detail\"}}, \"type\": \"object\", \"title\": \"HTTPValidationError\"}, \"Span\": {\"properties\": {\"start\": {\"type\": \"integer\", \"title\": \"Start\"}, \"end\": {\"type\": \"integer\", \"title\": \"End\"}, \"message\": {\"type\": \"string\", \"title\": \"Message\", \"default\": \"\"}, \"severity\": {\"type\": \"string\", \"title\": \"Severity\", \"default\": \"info\"}}, \"type\": \"object\", \"required\": [\"start\", \"end\"], \"title\": \"Span\"}, \"StatsOut\": {\"properties\": {\"solved\": {\"type\": \"integer\", \"title\": \"Solved\"}, \"attempts\": {\"type\": \"integer\", \"title\": \"Attempts\"}, \"streak_days\": {\"type\": \"integer\", \"title\": \"Streak Days\", \"default\": 0}, \"coins\": {\"type\": \"integer\", \"title\": \"Coins\", \"default\": 0}, \"solved_task_ids\": {\"items\": {\"type\": \"string\"}, \"type\": \"array\", \"title\": \"Solved Task Ids\"}}, \"type\": \"object\", \"required\": [\"solved\", \"attempts\"], \"title\": \"StatsOut\"}, \"UncertaintyPoint\": {\"properties\": {\"stage\": {\"type\": \"string\", \"title\": \"Stage\"}, \"reason_type\": {\"type\": \"string\", \"title\": \"Reason Type\"}, \"message\": {\"type\": \"string\", \"title\": \"Message\", \"default\": \"\"}, \"related_step_ids\": {\"items\": {\"type\": \"string\"}, \"type\": \"array\", \"title\": \"Related Step Ids\"}, \"related_criterion_ids\": {\"items\": {\"type\": \"string\"}, \"type\": \"array\", \"title\": \"Related Criterion Ids\"}, \"related_check_ids\": {\"items\": {\"type\": \"string\"}, \"type\": \"array\", \"title\": \"Related Check Ids\"}, \"related_block_ids\": {\"items\": {\"type\": \"string\"}, \"type\": \"array\", \"title\": \"Related Block Ids\"}}, \"type\": \"object\", \"required\": [\"stage\", \"reason_type\"], \"title\": \"UncertaintyPoint\"}, \"ValidationError\": {\"properties\": {\"loc\": {\"items\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"integer\"}]}, \"type\": \"array\", \"title\": \"Location\"}, \"msg\": {\"type\": \"string\", \"title\": \"Message\"}, \"type\": {\"type\": \"string\", \"title\": \"Error Type\"}}, \"type\": \"object\", \"required\": [\"loc\", \"msg\", \"type\"], \"title\": \"ValidationError\"}, \"DetailError\": {\"type\": \"object\", \"required\": [\"detail\"], \"properties\": {\"detail\": {\"type\": \"string\"}}}, \"DomainError\": {\"type\": \"object\", \"required\": [\"error\"], \"properties\": {\"error\": {\"type\": \"string\"}}}, \"ValidationProblem\": {\"oneOf\": [{\"$ref\": \"#/definitions/DetailError\"}, {\"$ref\": \"#/definitions/HTTPValidationError\"}]}}"
