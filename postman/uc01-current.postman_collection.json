  "item": [
    {
      "name": "00 · Получить учебные токены",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/_demo/session",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const sessionPayload = pm.response.json();",
              "pm.test('Изолированный стенд', () => pm.expect(sessionPayload.mode).to.eql('current_source_fixture'));",
              "pm.collectionVariables.set('token', sessionPayload.token);",
              "pm.collectionVariables.set('other_token', sessionPayload.other_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "P01 · Оценка и история только своего ученика",
      "item": [
        {
          "name": "Подготовить изолированные данные",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/_demo/reset",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"final\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Отправить решение",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_id\": \"{{task_id}}\",\n  \"text\": \"а) 2cos(x) - 1 = 0, откуда cos(x) = 1/2. Поэтому x = ±π/3 + 2πn, n ∈ Z. б) На отрезке [0; 2π] получаем π/3 и 5π/3. Ответ: а) ±π/3 + 2πn, n ∈ Z; б) π/3, 5π/3.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const definitions = JSON.parse(pm.collectionVariables.get('schemas'));",
                  "const schema = Object.assign({\"$ref\": \"#/definitions/AttemptOut\"}, {definitions});",
                  "pm.test('Ответ соответствует схеме', () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test('Получен полный балл', () => {pm.expect(body.score).to.eql(2); pm.expect(body.is_solved).to.eql(true);});",
                  "pm.collectionVariables.set('attempt_id', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Найти свою попытку в истории",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/tasks/{{task_id}}/attempts?limit=50&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const definitions = JSON.parse(pm.collectionVariables.get('schemas'));",
                  "const schema = Object.assign({\"type\": \"array\", \"items\": {\"$ref\": \"#/definitions/AttemptOut\"}}, {definitions});",
                  "pm.test('Ответ соответствует схеме', () => pm.response.to.have.jsonSchema(schema));",
                  "pm.test('Своя сохранённая попытка', () => {pm.expect(body).to.have.lengthOf(1); pm.expect(body[0].id).to.eql(pm.collectionVariables.get('attempt_id'));});"
                ]
              }
            }
          ]
        },
        {
          "name": "История другого ученика пуста",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/tasks/{{task_id}}/attempts",
