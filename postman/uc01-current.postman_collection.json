                  "pm.test('Ответ соответствует схеме', () => pm.response.to.have.jsonSchema(schema));"
                ]
              }
            }
          ]
        },
        {
          "name": "Проверить побочные действия",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/_demo/state",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test('Сохранения и вызовы оценивания', () => pm.expect(pm.response.json()).to.eql({attempts:1,pipeline_calls:1}));"
                ]
              }
            }
          ]
        }
      ]
    },
