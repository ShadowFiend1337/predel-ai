                  "const schema = Object.assign({\"allOf\": [{\"$ref\": \"#/definitions/ErrorV2\"}, {\"type\": \"object\", \"properties\": {\"error\": {\"type\": \"object\", \"properties\": {\"code\": {\"enum\": [\"VALIDATION_ERROR\"]}}}}}]}, {definitions});",
                  "pm.test('Ответ соответствует схеме', () => pm.response.to.have.jsonSchema(schema));"
                ]
              }
            }
          ]
        }
