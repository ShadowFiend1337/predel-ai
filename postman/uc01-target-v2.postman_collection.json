sion\": {\"$ref\": \"#/definitions/DecisionV2\"}, \"result_status\": {\"const\": \"final\", \"title\": \"Result Status\", \"type\": \"string\"}, \"score\": {\"minimum\": 0, \"title\": \"Score\", \"type\": \"number\"}, \"is_solved\": {\"title\": \"Is Solved\", \"type\": \"boolean\"}, \"review\": {\"anyOf\": [{\"$ref\": \"#/definitions/CompletedReviewV2\"}, {\"type\": \"null\"}]}}, \"required\": [\"schema_version\", \"id\", \"task_id\", \"solution_text\", \"created_at\", \"max_score\", \"feedback\", \"decision\", \"result_status\", \"score\", \"is_solved\", \"review\"], \"title\": \"FinalAttemptV2\", \"type\": \"object\"}, \"PendingReviewV2\": {\"additionalProperties\": false, \"properties\": {\"id\": {\"minLength\": 1, \"pattern\": \"\\\\S\", \"title\": \"Id\", \"type\": \"string\"}, \"status\": {\"enum\": [\"pending\", \"in_progress\"], \"title\": \"Status\", \"type\": \"string\"}}, \"required\": [\"id\", \"status\"], \"title\": \"PendingReviewV2\", \"type\": \"object\"}, \"ProvisionalAttemptV2\": {\"additionalProperties\": false, \"properties\": {\"schema_version\": {\"const\": \"2.0\", \"title\": \"Schema Version\", \"type\": \"string\"}, \"id\": {\"minLength\": 1, \"pattern\": \"\\\\S\", \"title\": \"Id\", \"type\": \"string\"}, \"task_id\": {\"minLength\": 1, \"pattern\": \"\\\\S\", \"title\": \"Task Id\", \"type\": \"string\"}, \"solution_text\": {\"maxLength\": 40000, \"minLength\": 1, \"pattern\": \"\\\\S\", \"title\": \"Solution Text\", \"type\": \"string\"}, \"created_at\": {\"format\": \"date-time\", \"title\": \"Created At\", \"type\": \"string\"}, \"max_score\": {\"exclusiveMinimum\": 0, \"title\": \"Max Score\", \"type\": \"number\"}, \"feedback\": {\"$ref\": \"#/definitions/StudentFeedbackV2\"}, \"decision\": {\"$ref\": \"#/definitions/DecisionV2\"}, \"result_status\": {\"const\": \"provisional\", \"title\": \"Result Status\", \"type\": \"string\"}, \"score\": {\"anyOf\": [{\"minimum\": 0, \"type\": \"number\"}, {\"type\": \"null\"}], \"title\": \"Score\"}, \"is_solved\": {\"const\": false, \"title\": \"Is Solved\", \"type\": \"boolean\"}, \"review\": {\"$ref\": \"#/definitions/PendingReviewV2\"}}, \"required\": [\"schema_version\", \"id\", \"task_id\", \"solution_text\", \"created_at\", \"max_score\", \"feedback\", \"decision\", \"result_status\", \"score\", \"is_solved\", \"review\"], \"title\": \"ProvisionalAttemptV2\", \"type\": \"object\"}, \"StudentFeedbackV2\": {\"additionalProperties\": false, \"properties\": {\"general_comment\": {\"minLength\": 1, \"pattern\": \"\\\\S\", \"title\": \"General Comment\", \"type\": \"string\"}, \"comments\": {\"items\": {\"type\": \"string\"}, \"title\": \"Comments\", \"type\": \"array\"}}, \"required\": [\"general_comment\", \"comments\"], \"title\": \"StudentFeedbackV2\", \"type\": \"object\"}, \"AttemptV2\": {\"discriminator\": {\"mapping\": {\"final\": \"#/definitions/FinalAttemptV2\", \"provisional\": \"#/definitions/ProvisionalAttemptV2\"}, \"propertyName\": \"result_status\"}, \"oneOf\": [{\"$ref\": \"#/definitions/FinalAttemptV2\"}, {\"$ref\": \"#/definitions/ProvisionalAttemptV2\"}], \"title\": \"AttemptV2\", \"x-invariants\": [\"0 <= score <= max_score, если score не null\", \"final: is_solved эквивалентен score == max_score\", \"provisional: is_solved=false, review.id существует, reason_codes непусты\", \"final с review: status=completed и source=curator; без review source != curator\", \"Числовой балл требует source != none\"]}, \"ErrorDetailV2\": {\"additionalProperties\": false, \"properties\": {\"code\": {\"enum\": [\"AUTH_REQUIRED\", \"TASK_NOT_FOUND\", \"VALIDATION_ERROR\", \"RATE_LIMITED\", \"GRADING_UNAVAILABLE\", \"PERSISTENCE_FAILURE\", \"PERSISTENCE_OUTCOME_UNKNOWN\", \"INTERNAL_ERROR\"], \"title\": \"Code\", \"type\": \"string\"}, \"message\": {\"minLength\": 1, \"pattern\": \"\\\\S\", \"title\": \"Message\", \"type\": \"string\"}, \"retryable\": {\"title\": \"Retryable\", \"type\": \"boolean\"}}, \"required\": [\"code\", \"message\", \"retryable\"], \"title\": \"ErrorDetailV2\", \"type\": \"object\"}, \"ErrorV2\": {\"additionalProperties\": false, \"properties\": {\"schema_version\": {\"const\": \"2.0\", \"title\": \"Schema Version\", \"type\": \"string\"}, \"request_id\": {\"minLength\": 1, \"pattern\": \"\\\\S\", \"title\": \"Request Id\", \"type\": \"string\"}, \"result\": {\"title\": \"Result\", \"type\": \"null\"}, \"error\": {\"$ref\": \"#/definitions/ErrorDetailV2\"}}, \"required\": [\"schema_version\", \"request_id\", \"result\", \"error\"], \"title\": \"ErrorV2\", \"type\": \"object\"}}"
