        <di:waypoint x="1530" y="650" />
        <di:waypoint x="1530" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_M_in" bpmnElement="M_in">
        <di:waypoint x="108" y="105" />
        <di:waypoint x="108" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_M_auto" bpmnElement="M_auto">
        <di:waypoint x="1105" y="190" />
        <di:waypoint x="1105" y="145" />
        <di:waypoint x="1390" y="145" />
        <di:waypoint x="1390" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_M_review" bpmnElement="M_review">
