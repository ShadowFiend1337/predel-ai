        <di:waypoint x="760" y="382" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F9" bpmnElement="F9">
        <di:waypoint x="640" y="345" />
        <di:waypoint x="640" y="537" />
        <di:waypoint x="760" y="537" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_save_Auto" bpmnElement="F_save_Auto">
        <di:waypoint x="920" y="225" />
        <di:waypoint x="1030" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_end_Auto" bpmnElement="F_end_Auto">
        <di:waypoint x="1180" y="225" />
        <di:waypoint x="1300" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_save_Review" bpmnElement="F_save_Review">
        <di:waypoint x="940" y="382" />
        <di:waypoint x="1030" y="382" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_end_Review" bpmnElement="F_end_Review">
        <di:waypoint x="1180" y="382" />
        <di:waypoint x="1300" y="382" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_save_Failure" bpmnElement="F_save_Failure">
        <di:waypoint x="940" y="537" />
        <di:waypoint x="1030" y="537" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_end_Failure" bpmnElement="F_end_Failure">
        <di:waypoint x="1180" y="537" />
        <di:waypoint x="1300" y="537" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_persist_send" bpmnElement="F_persist_send">
        <di:waypoint x="1550" y="605" />
        <di:waypoint x="1590" y="607" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_persist_end" bpmnElement="F_persist_end">
        <di:waypoint x="1750" y="607" />
        <di:waypoint x="1800" y="607" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_error_Auto" bpmnElement="F_error_Auto">
        <di:waypoint x="885" y="275" />
