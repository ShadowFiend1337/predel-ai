<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Predel" targetNamespace="https://predelai.example/analysis" exporter="PredelAI analysis case" exporterVersion="1.0">
  <bpmn:error id="PersistenceError" name="Ошибка сохранения" errorCode="PERSISTENCE_FAILURE" />
  <bpmn:process id="Process_Check" name="Целевая автоматическая обработка решения" isExecutable="false">
    <bpmn:documentation>Целевая модель. Проверка решения свёрнута в задачу; ручное рассмотрение после назначения находится за границей процесса. Условия шлюзов являются аналитическими выражениями.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Решение поступило">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="StartMessage" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Validate" name="Проверить входные данные">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Вход допустим?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Check" name="Проверить решение">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Outcome" name="Результат проверки">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="SaveAuto" name="Сохранить окончательную оценку">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F_save_Auto</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendAuto" name="Сообщить оценку">
      <bpmn:incoming>F_save_Auto</bpmn:incoming>
      <bpmn:outgoing>F_end_Auto</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndAuto" name="Оценка готова">
      <bpmn:incoming>F_end_Auto</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="SaveReview" name="Сохранить предварительный результат и задачу куратора">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F_save_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendReview" name="Сообщить о ручной проверке">
      <bpmn:incoming>F_save_Review</bpmn:incoming>
      <bpmn:outgoing>F_end_Review</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndReview" name="Ожидает куратора">
      <bpmn:incoming>F_end_Review</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="SaveFailure" name="Сохранить техническую ошибку без оценки">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F_save_Failure</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SendFailure" name="Сообщить об отсутствии оценки">
      <bpmn:incoming>F_save_Failure</bpmn:incoming>
      <bpmn:outgoing>F_end_Failure</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndFailure" name="Оценка не получена">
      <bpmn:incoming>F_end_Failure</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SendInvalid" name="Объяснить ошибку входных данных">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndInvalid" name="Запрос отклонён">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="PersistenceJoin" name="">
      <bpmn:outgoing>F_persist_send</bpmn:outgoing>
      <bpmn:incoming>F_error_Auto</bpmn:incoming>
      <bpmn:incoming>F_error_Review</bpmn:incoming>
      <bpmn:incoming>F_error_Failure</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendPersistence" name="Сообщить об ошибке сохранения">
      <bpmn:incoming>F_persist_send</bpmn:incoming>
      <bpmn:outgoing>F_persist_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndPersistence" name="Результат не сохранён">
      <bpmn:incoming>F_persist_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryAuto" name="Ошибка сохранения" attachedToRef="SaveAuto" cancelActivity="true">
      <bpmn:outgoing>F_error_Auto</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="PersistenceError" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryReview" name="Ошибка сохранения" attachedToRef="SaveReview" cancelActivity="true">
      <bpmn:outgoing>F_error_Review</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="PersistenceError" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryFailure" name="Ошибка сохранения" attachedToRef="SaveFailure" cancelActivity="true">
      <bpmn:outgoing>F_error_Failure</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="PersistenceError" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Validate" />
    <bpmn:sequenceFlow id="F2" sourceRef="Validate" targetRef="Valid" />
    <bpmn:sequenceFlow id="F3" sourceRef="Valid" targetRef="Check" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">input_valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="Valid" targetRef="SendInvalid" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not input_valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="SendInvalid" targetRef="EndInvalid" />
    <bpmn:sequenceFlow id="F6" sourceRef="Check" targetRef="Outcome" />
    <bpmn:sequenceFlow id="F7" sourceRef="Outcome" targetRef="SaveAuto" name="Окончательная оценка">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "final"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="Outcome" targetRef="SaveReview" name="Нужен куратор">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="Outcome" targetRef="SaveFailure" name="Технический отказ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == "failed"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_save_Auto" sourceRef="SaveAuto" targetRef="SendAuto" />
    <bpmn:sequenceFlow id="F_end_Auto" sourceRef="SendAuto" targetRef="EndAuto" />
    <bpmn:sequenceFlow id="F_save_Review" sourceRef="SaveReview" targetRef="SendReview" />
    <bpmn:sequenceFlow id="F_end_Review" sourceRef="SendReview" targetRef="EndReview" />
    <bpmn:sequenceFlow id="F_save_Failure" sourceRef="SaveFailure" targetRef="SendFailure" />
    <bpmn:sequenceFlow id="F_end_Failure" sourceRef="SendFailure" targetRef="EndFailure" />
    <bpmn:sequenceFlow id="F_persist_send" sourceRef="PersistenceJoin" targetRef="SendPersistence" />
    <bpmn:sequenceFlow id="F_persist_end" sourceRef="SendPersistence" targetRef="EndPersistence" />
    <bpmn:sequenceFlow id="F_error_Auto" sourceRef="BoundaryAuto" targetRef="PersistenceJoin" />
    <bpmn:sequenceFlow id="F_error_Review" sourceRef="BoundaryReview" targetRef="PersistenceJoin" />
    <bpmn:sequenceFlow id="F_error_Failure" sourceRef="BoundaryFailure" targetRef="PersistenceJoin" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_Check">
    <bpmn:participant id="Student" name="Ученик" />
    <bpmn:participant id="Predel" name="PredelAI — целевая модель" processRef="Process_Check" />
    <bpmn:messageFlow id="M_in" sourceRef="Student" targetRef="Start" />
    <bpmn:messageFlow id="M_auto" sourceRef="SendAuto" targetRef="Student" />
    <bpmn:messageFlow id="M_review" sourceRef="SendReview" targetRef="Student" />
    <bpmn:messageFlow id="M_failure" sourceRef="SendFailure" targetRef="Student" />
    <bpmn:messageFlow id="M_invalid" sourceRef="SendInvalid" targetRef="Student" />
    <bpmn:messageFlow id="M_persistence" sourceRef="SendPersistence" targetRef="Student" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_Check">
    <bpmndi:BPMNPlane id="Plane_Check" bpmnElement="Collaboration_Check">
      <bpmndi:BPMNShape id="Shape_Student" bpmnElement="Student" isHorizontal="true">
        <dc:Bounds x="20" y="25" width="1850" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Predel" bpmnElement="Predel" isHorizontal="true">
        <dc:Bounds x="20" y="155" width="1850" height="630" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="90" y="310" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Validate">
        <dc:Bounds x="155" y="290" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Valid" bpmnElement="Valid">
        <dc:Bounds x="330" y="305" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Check" bpmnElement="Check">
        <dc:Bounds x="425" y="290" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Outcome" bpmnElement="Outcome">
        <dc:Bounds x="620" y="305" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SaveAuto" bpmnElement="SaveAuto">
        <dc:Bounds x="760" y="190" width="160" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendAuto" bpmnElement="SendAuto">
        <dc:Bounds x="1030" y="190" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndAuto" bpmnElement="EndAuto">
        <dc:Bounds x="1300" y="207" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SaveReview" bpmnElement="SaveReview">
        <dc:Bounds x="760" y="340" width="180" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendReview" bpmnElement="SendReview">
        <dc:Bounds x="1030" y="340" width="150" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndReview" bpmnElement="EndReview">
        <dc:Bounds x="1300" y="365" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SaveFailure" bpmnElement="SaveFailure">
        <dc:Bounds x="760" y="500" width="180" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendFailure" bpmnElement="SendFailure">
        <dc:Bounds x="1030" y="500" width="150" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndFailure" bpmnElement="EndFailure">
        <dc:Bounds x="1300" y="519" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendInvalid" bpmnElement="SendInvalid">
        <dc:Bounds x="425" y="650" width="155" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndInvalid" bpmnElement="EndInvalid">
        <dc:Bounds x="620" y="667" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PersistenceJoin" bpmnElement="PersistenceJoin">
        <dc:Bounds x="1510" y="585" width="40" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendPersistence" bpmnElement="SendPersistence">
        <dc:Bounds x="1590" y="570" width="160" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndPersistence" bpmnElement="EndPersistence">
        <dc:Bounds x="1800" y="589" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryAuto" bpmnElement="BoundaryAuto">
        <dc:Bounds x="870" y="245" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryReview" bpmnElement="BoundaryReview">
        <dc:Bounds x="910" y="410" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BoundaryFailure" bpmnElement="BoundaryFailure">
        <dc:Bounds x="870" y="560" width="30" height="30" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F1" bpmnElement="F1">
        <di:waypoint x="126" y="328" />
        <di:waypoint x="155" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F2" bpmnElement="F2">
        <di:waypoint x="285" y="325" />
        <di:waypoint x="330" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F3" bpmnElement="F3">
        <di:waypoint x="370" y="325" />
        <di:waypoint x="425" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F4" bpmnElement="F4">
        <di:waypoint x="350" y="345" />
        <di:waypoint x="350" y="685" />
        <di:waypoint x="425" y="685" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F5" bpmnElement="F5">
        <di:waypoint x="580" y="685" />
        <di:waypoint x="620" y="685" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F6" bpmnElement="F6">
        <di:waypoint x="565" y="325" />
        <di:waypoint x="620" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F7" bpmnElement="F7">
        <di:waypoint x="640" y="305" />
        <di:waypoint x="640" y="225" />
        <di:waypoint x="760" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F8" bpmnElement="F8">
        <di:waypoint x="660" y="325" />
