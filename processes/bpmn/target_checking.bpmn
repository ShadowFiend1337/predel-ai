      <bpmndi:BPMNEdge id="Edge_M_persistence" bpmnElement="M_persistence">
        <di:waypoint x="1670" y="570" />
        <di:waypoint x="1670" y="105" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>